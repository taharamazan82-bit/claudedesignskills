# Alfred environment — COPY to .env and fill in. NEVER commit the real .env.
# Keys are read only by the backend/tools, never sent to the browser.
# You need at least ONE provider key. Groq alone is enough to start.

# --- LLM providers (free tier) ---
GROQ_API_KEY=
# Optional model overrides (sensible defaults are built in):
# GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Provider try-order (comma list). Default: groq,gemini,openrouter
# ALFRED_PROVIDER_ORDER=groq,gemini,openrouter

# --- Web search (Module 4; keyless DuckDuckGo works without any key) ---
BRAVE_API_KEY=

# --- YouTube (Module 5; filled by the one-time OAuth wizard, not by hand) ---
# YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
